*.onnx binary
*.wasm binary
*.jpg binary
*.jpeg binary
*.png binary
*.zip binary

# styles.css is a shipped release asset, not just source. With core.autocrlf=true
# the worktree kept CRLF while the committed blob stayed LF, so every local check
# validated 325,907 bytes while CI published 311,704 - the exact file users got was
# never the file the gate saw. Pin the checkout to LF so the worktree, the blob and
# the release asset are the same bytes.
outputs/cancip/styles.css text eol=lf

# The released manifest.json has exactly the same problem as styles.css above:
# with core.autocrlf=true the worktree keeps CRLF while the committed blob stays
# LF, so "does the worktree match the blob" compares two different files and the
# release gate reports a byte mismatch on a file nobody edited. Pin both copies
# to LF so the worktree, the blob and the shipped asset are the same bytes.
/manifest.json text eol=lf
/outputs/cancip/manifest.json text eol=lf

# `main.js` and the other build outputs are byte-compared by the release gate.
# esbuild and the generators all emit LF, so with core.autocrlf=true the next
# checkout would hand the gate a CRLF copy and it would report a byte mismatch on
# a file nobody edited - the same false alarm already fixed for styles.css and
# manifest.json. `src/generated/*.ts` is listed too: those bytes are gzipped
# straight into main.js, so a line-ending flip there silently changes the bundle.
/outputs/cancip/main.js text eol=lf
/outputs/cancip/prime-tts-worker.js text eol=lf
/outputs/cancip/versions.json text eol=lf
/versions.json text eol=lf
/src/generated/*.ts text eol=lf

# The CLI is read by the generator and shipped as a release asset, so its line
# endings must not depend on the developer's core.autocrlf setting. Without this
# pin a Windows build embedded CRLF into main.js while CI embedded LF, and the two
# builds published different bytes for the same version.
/cli/cancip-cli.mjs text eol=lf
/outputs/cancip/cancip-cli.mjs text eol=lf
