{
  "name": "cancip",
  "version": "3.5.36",
  "private": true,
  "main": "main.js",
  "scripts": {
    "verify:source-bundle": "node scripts/verify-source-bundle-guards.mjs",
    "verify:source-parity": "node scripts/verify-source-runtime-parity.mjs",
    "verify:feature-regressions": "node scripts/verify-feature-regressions.mjs",
    "verify:agent-bridge": "node scripts/verify-agent-bridge.mjs",
    "verify:queue-bridge": "node scripts/verify-queue-bridge.mjs",
    "verify:idle-scheduling": "node scripts/verify-idle-scheduling.mjs",
    "verify:cli-queue": "node scripts/verify-cli-queue-transport.mjs",
    "verify:plugin-compatibility": "node scripts/verify-plugin-compatibility.mjs",
    "verify:obsidian-community": "node scripts/verify-obsidian-community-standards.mjs",
    "verify:release-triplet": "node scripts/verify-release-triplet.mjs",
    "verify:bundle-loads": "node scripts/verify-bundle-loads.mjs outputs/cancip/main.js",
    "test:release-triplet-mutations": "node scripts/verify-release-triplet-mutations.mjs",
    "test:office-context-edit": "node scripts/verify-office-context-edit.mjs",
    "test:document-package-edit": "node scripts/verify-document-package-edit.mjs",
    "test:tts": "node scripts/verify-tts-regression.mjs",
    "build:ocr-package": "node scripts/prepare-ocr-package.mjs",
    "build": "npm run verify:source-bundle && npm run verify:source-parity && npm run verify:feature-regressions && npm run verify:agent-bridge && npm run verify:queue-bridge && npm run verify:idle-scheduling && npm run verify:cli-queue && npm run verify:plugin-compatibility && npm run verify:obsidian-community && npm run test:office-context-edit && npm run test:document-package-edit && npm run verify:api-endpoint && tsc --noEmit --skipLibCheck && node scripts/prepare-release-output.mjs && node esbuild.config.mjs production && npm run verify:bundle-loads && npm run verify:release-triplet",
    "check": "tsc --noEmit --skipLibCheck",
    "verify": "npm run check && npm run build",
    "verify:api-endpoint": "node scripts/verify-api-endpoint-resolution.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "esbuild": "^0.25.12",
    "obsidian": "^1.13.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "fflate": "^0.8.2",
    "html2canvas": "^1.4.1",
    "onnxruntime-web": "^1.27.0",
    "pinyin-pro": "^3.28.1",
    "tesseract.js": "6.0.1"
  }
}
